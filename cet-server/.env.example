# Copier ce fichier en .env et remplir.
# Sans .env → mode TEST (aucun mail réel, boîte de test sur /boite-test)

PORT=3000

# ── Sur Vercel uniquement (obligatoires) ──
# SESSION_SECRET=valeur_aleatoire_longue
# CRON_SECRET=autre_valeur_aleatoire
# Adresse du bouton « Ouvrir la demande » dans le mail (nom ou IP du PC/serveur)
PUBLIC_URL=http://NOM-DU-PC:3000

MAIL_TO=vfdeux@norimagerie.com,mpchenal@norimagerie.com

# ── Stockage Supabase (sinon : fichiers locaux dans data/) ──
# Supabase > Project Settings > API : Project URL + clé "service_role" (secrète, serveur uniquement)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Seulement si le CET est installé dans un projet existant (schema-projet-existant.sql) :
# SUPABASE_SCHEMA=cet

# ── Envoi des emails via Microsoft Graph (voir README > Envoi des emails) ──
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# MAIL_SENDER=demande-cet-noreply@norimagerie.fr
# MAIL_SENDER_NAME=Demandes CET Norimagerie
# MAIL_CONFIRMATION_SALARIE=true

# ── Alternative SMTP (seulement si Graph n'est pas possible) ──
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@norimagerie.com
# SMTP_PASS=...
# MAIL_FROM="Demandes CET <noreply@norimagerie.com>"
